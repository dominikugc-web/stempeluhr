rules_version = '2';
// Zugriffsregeln der Stempeluhr. In der Firebase-Konsole unter Firestore → Regeln einfügen
// (oder mit `firebase deploy --only firestore:rules`).
//
// data/{uid}      Zeiten, Abwesenheiten, Arbeitszeit-Einstellungen. Lesen/ändern: der Nutzer selbst
//                 und der Chef seiner Firma, sobald er den Mitarbeiter freigegeben hat.
// private/{uid}   Gehalt, Steuerklasse, Standorte, Aussehen. Schreiben nur der Nutzer selbst, lesen zusätzlich der
//                 Entwickler-Support (isAdmin), damit er die App 1:1 wie der Nutzer sieht. Geschäftsführer nie.
// companies/{cid} Firma (Name, Gründer, Einladungscode, Kontakt). Lesen: Geschäftsführer und freigegebene Mitarbeiter.
//   members/{uid} Beitrittsanfrage bzw. Mitgliedschaft (status: pending | active, role: 'boss' = weiterer Geschäftsführer).
//   admin/{doc}   Gemeinsame Einstellungen der Geschäftsführer (Lohn-Schnittstelle, Steuernummern). Nur Geschäftsführer.
// invites/{code}  Einladungscode → Firma. Jeder Angemeldete darf einen Code nachschlagen.
// Entwickler (isAdmin): sieht und korrigiert alles; private/{uid} nur lesen. Neue Entwickler-UID unten eintragen
// (Firebase-Konsole → Authentication → Nutzer-UID) und mit `firebase deploy --only firestore:rules` einspielen.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid in ['Pb3LEKsVdveCrDdWyhuqOkoNcc63']; }
    function companyPath(cid) { return /databases/$(db)/documents/companies/$(cid); }
    function memberPath(cid, uid) { return /databases/$(db)/documents/companies/$(cid)/members/$(uid); }
    function isActive(cid, uid) {
      return exists(memberPath(cid, uid)) && get(memberPath(cid, uid)).data.status == 'active';
    }
    // Geschäftsführer: Gründer der Firma, freigegebenes Mitglied mit role 'boss' oder Entwickler
    function isOwner(cid) {
      return cid is string && exists(companyPath(cid)) && (get(companyPath(cid)).data.owner == request.auth.uid || isAdmin()
        || (isActive(cid, request.auth.uid) && get(memberPath(cid, request.auth.uid)).data.get('role', '') == 'boss'));
    }
    // Gehört uid zur Firma? (freigegebenes Mitglied oder Gründer)
    function inCompany(cid, uid) { return isActive(cid, uid) || get(companyPath(cid)).data.owner == uid; }
    function bossOf(cid, uid) { return isOwner(cid) && inCompany(cid, uid); }

    match /data/{uid} {
      allow read: if isAdmin() || (signedIn() && (request.auth.uid == uid || bossOf(resource.data.cid, uid)));
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid
        || ((bossOf(resource.data.cid, uid) || isAdmin()) && request.resource.data.cid == resource.data.cid));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /private/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Lohnabrechnungen: Geschäftsführer der Firma lädt hoch, nur der Mitarbeiter selbst (und der GF) sieht sie.
    match /payslips/{uid}/docs/{id} {
      allow read: if signedIn() && (request.auth.uid == uid || bossOf(resource.data.cid, uid));
      allow create: if signedIn() && bossOf(request.resource.data.cid, uid)
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow update: if signedIn() && ((bossOf(resource.data.cid, uid) && request.resource.data.cid == resource.data.cid
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000)
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])));
      allow delete: if signedIn() && (request.auth.uid == uid || bossOf(resource.data.cid, uid));
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && isOwner(request.resource.data.cid);
      allow delete: if signedIn() && isOwner(resource.data.cid);
    }

    match /{path=**}/members/{mid} {
      allow read: if isAdmin();   // Entwickler-Übersicht: alle Mitgliedschaften auf einmal
    }

    // Feedback-Chat: jeder Nutzer mit dem Entwickler. Nutzer schreiben als 'user', der Entwickler als 'admin'.
    match /feedback/{uid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
      match /msgs/{mid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && ((request.auth.uid == uid && request.resource.data.from == 'user') || (isAdmin() && request.resource.data.from == 'admin'));
        allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);   // Konto löschen
      }
    }

    match /companies/{cid} {
      allow read: if isAdmin() || (signedIn() && (resource.data.owner == request.auth.uid || isActive(cid, request.auth.uid)));
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow update: if signedIn() && isOwner(cid) && request.resource.data.owner == resource.data.owner;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;   // Gründer löscht sein Konto

      match /admin/{doc} {
        allow read, write: if signedIn() && isOwner(cid);
      }

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isOwner(cid));
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.status == 'pending' && !('role' in request.resource.data)
          && get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.cid == cid;
        allow update: if signedIn() && isOwner(cid);
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(cid));
      }
    }
  }
}
